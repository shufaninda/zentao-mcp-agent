# 被测系统
ZENTAO_BASE=http://127.0.0.1:8080
ZENTAO_ACCOUNT=admin
ZENTAO_PASSWORD=123456
ZENTAO_ALT_ACCOUNT=test1
ZENTAO_ALT_PASSWORD=123456
REQUEST_TIMEOUT=10

# token 缓存
TOKEN_TTL_SECONDS=1800

# db_check：禅道业务库【只读】账号（不配则 db_check 跳过）
# ZENTAO_DB_DSN=mysql://readonly_user:pass@127.0.0.1:3306/zentao
DBCHECK_POLL_INTERVAL=0.2
DBCHECK_MAX_POLLS=5

# 记忆层：week1 SQLite（默认），week2 换 MySQL
# LEDGER_DSN=mysql://user:pass@127.0.0.1:3306/zentao_memory

# 功能开关：先只跑不建单（误报率可接受后再开）
AUTO_CREATE_BUG=false

# 执行保护
SETUP_BREAKER_THRESHOLD=3
MAX_CASES_PER_RUN=60

# 记忆层：默认 SQLite（零依赖）；切换 MySQL 只改这一行，schema 完全一致
# 记忆层默认 SQLite（零依赖，CI 用）；本地推荐独立 mysql:8.0 容器：
#   docker run -d --name zentao-memory -p 3307:3306 -e MYSQL_ROOT_PASSWORD=root \
#     -e MYSQL_DATABASE=zentao_memory -e MYSQL_USER=agent -e MYSQL_PASSWORD=agent123 mysql:8.0
# LEDGER_DSN=mysql://agent:agent123@127.0.0.1:3307/zentao_memory

# db_check：禅道业务库只读账号（不配则该断言跳过）
# ZENTAO_DB_DSN=mysql://ro_agent:ro123@127.0.0.1:3306/zentao

# 探索模式（LLM 生成用例）：不配则 generate 显式报 LLMUnavailable，禁止假装成功
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
