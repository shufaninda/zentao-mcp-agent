{
  "description": "金标准注入集。每个缺陷 = 已知正确答案的故障注入（AI 代码审核方法论：评测集）。",
  "levels": {
    "L1": "明显（状态码/字段缺失类）",
    "L2": "中等（校验失效/边界不处理）",
    "L3": "隐蔽（越权/并发/软删除），week2+ 实现注入方式"
  },
  "defects": [
    {
      "id": "DEF_PRE_001",
      "level": "L2",
      "name": "任务名称无长度上限（禅道原生缺陷，无需注入）",
      "kind": "preexisting",
      "catching_case": "BUG_LEN_001",
      "expected_category": "product_bug",
      "expected_dimension": "boundary"
    },
    {
      "id": "DEF_L2_001",
      "level": "L2",
      "name": "禁用任务名称必填校验（API form 层 required=false）",
      "kind": "source_patch",
      "file": "/apps/zentao/module/task/config/form.php",
      "find": "$config->task->form->create['name']         = array('type' => 'string',   'required' => true,  'default' => '');",
      "replace": "$config->task->form->create['name']         = array('type' => 'string',   'required' => false,  'default' => '');",
      "catching_case": "BUG_EMPTY_001",
      "expected_category": "product_bug",
      "expected_dimension": "eq_invalid"
    },
    {
      "id": "DEF_L2_002",
      "level": "L2",
      "name": "禁用任务名称非空校验（model 层 requiredFields 去掉 name）",
      "kind": "source_patch",
      "file": "/apps/zentao/module/task/config.php",
      "find": "$config->task->create->requiredFields      = 'execution,name,type';",
      "replace": "$config->task->create->requiredFields      = 'execution,type';",
      "catching_case": "BUG_EMPTY_001",
      "expected_category": "product_bug",
      "expected_dimension": "eq_invalid",
      "requires": [
        "DEF_L2_001"
      ]
    },
    {
      "id": "DEF_L2_003",
      "level": "L2",
      "name": "禁用 Bug 标题必填（form 层 + model 层双补丁，缺一不生效）",
      "kind": "source_patch",
      "file": "/apps/zentao/module/bug/config/form.php",
      "find": "$config->bug->form->create['title']       = array('required' => true,  'type' => 'string', 'filter' => 'trim');",
      "replace": "$config->bug->form->create['title']       = array('required' => false,  'type' => 'string', 'filter' => 'trim');",
      "catching_case": "BUG_TITLE_001",
      "expected_category": "product_bug",
      "expected_dimension": "eq_invalid",
      "requires": [
        "DEF_L2_004"
      ]
    },
    {
      "id": "DEF_L2_004",
      "level": "L2",
      "name": "Bug requiredFields 去掉 title（model 层）",
      "kind": "source_patch",
      "file": "/apps/zentao/module/bug/config.php",
      "find": "$config->bug->create->requiredFields      = 'title,openedBuild';",
      "replace": "$config->bug->create->requiredFields      = 'openedBuild';",
      "catching_case": "BUG_TITLE_001",
      "expected_category": "product_bug",
      "expected_dimension": "eq_invalid",
      "requires": [
        "DEF_L2_003"
      ]
    },
    {
      "id": "DRILL_ENV_001",
      "level": "drill",
      "name": "非缺陷对照：停容器（环境问题）",
      "kind": "drill_env_stop",
      "catching_case": "BUG_EMPTY_001",
      "expected_category": "env_issue"
    },
    {
      "id": "DRILL_DEP_001",
      "level": "drill",
      "name": "非缺陷对照：用例间数据依赖（A 删 B 查）",
      "kind": "drill_data_dependency",
      "catching_case": "DEP_B_001",
      "expected_category": "data_dependency"
    },
    {
      "id": "DEF_L3_001",
      "level": "L3",
      "name": "框架层权限判断短路（checkPriv 恒不拦截）",
      "kind": "source_patch",
      "file": "/apps/zentao/framework/api/router.class.php",
      "find": "        if($module and $method and !$common->isOpenMethod($module, $method) and !commonModel::hasPriv($module, $method))",
      "replace": "        if(false)",
      "catching_case": "BUG_PRIV_001",
      "expected_category": "product_bug",
      "expected_dimension": "auth",
      "note": "改框架核心文件：本地靶场可逆（.orig 备份），绝不对生产环境使用"
    },
    {
      "id": "DEF_L3_002",
      "level": "L3",
      "name": "entry 层权限判断短路（与 DEF_L3_001 成对生效）",
      "kind": "source_patch",
      "file": "/apps/zentao/framework/api/entry.class.php",
      "find": "        if($module and $method and !$this->loadModel('common')->isOpenMethod($module, $method) and !commonModel::hasPriv($module, $method))",
      "replace": "        if(false)",
      "catching_case": "BUG_PRIV_001",
      "expected_category": "product_bug",
      "expected_dimension": "auth",
      "requires": [
        "DEF_L3_001"
      ]
    }
  ]
}